---
import Icon from "./Icon.astro";
---

<header class="flex items-center px-gutter pt-4.5 lg:px-0 lg:pt-7">
  <div class="flex items-center gap-2.5 lg:gap-3">
    <div
      class="flex size-8.5 items-center justify-center rounded-logo bg-plum text-on-plum lg:size-10 lg:rounded-logo-lg"
    >
      <Icon name="logo-mark" class="size-5 lg:size-5.5" />
    </div>
    <span class="font-display text-logo font-semibold lg:text-logo-lg">Personal CRM</span>
  </div>
</header>
